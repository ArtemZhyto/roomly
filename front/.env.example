# ==========================================================================
# ROOMLY FRONTEND ENVIRONMENT CONFIGURATION
# ==========================================================================
#
# Local development:
#   1. Copy this file to `.env`.
#   2. Keep MODE=dev.
#   3. Use URLs accessible from your browser.
#
# Docker development:
#   Docker Compose should load:
#     - .env
#     - .env.docker
#
# Docker production:
#   Docker Compose should load:
#     - .env
#     - .env.prod
#
# Later files override earlier values.
#
# Never commit `.env`, `.env.docker`, or `.env.prod`.
# Commit only `.env.example`.
#
# ==========================================================================


# ==========================================================================
# APPLICATION
# ==========================================================================

# Supported values: dev, prod
MODE=dev

# Public address of the frontend application
NEXT_PUBLIC_SITE=http://localhost:3030


# ==========================================================================
# API
# ==========================================================================

# Backend URL used by browser-side requests.
# This value must be reachable from the user's browser.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Backend URL used by Next.js server code and middleware.
# For local development it normally matches NEXT_PUBLIC_API_URL.
API_URL=http://localhost:5000


# ==========================================================================
# DOCKER DEVELOPMENT OVERRIDES - `.env.docker`
# ==========================================================================
#
# MODE=dev
# API_URL=http://roomly_service:5000
#
# NEXT_PUBLIC_API_URL is inherited from `.env` because browser requests
# cannot use the Docker-only service name `roomly_service`.
#
# ==========================================================================


# ==========================================================================
# DOCKER PRODUCTION OVERRIDES - `.env.prod`
# ==========================================================================
#
# MODE=prod
# API_URL=http://roomly_service:5000
#
# For a real deployment, set public URLs in `.env` to addresses reachable
# from the user's browser, for example:
#
# NEXT_PUBLIC_SITE=https://roomly.example.com
# NEXT_PUBLIC_API_URL=https://api.roomly.example.com
#
# ==========================================================================
