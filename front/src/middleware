// Modules
import { NextRequest, NextResponse } from 'next/server'

const PUBLIC_ROUTES = ['/login', '/register']

const API_URL = process.env.API_URL

if (!API_URL) {
  throw new Error('API_URL is not configured')
}

const redirectTo = (req: NextRequest, path: string): NextResponse => {
  return NextResponse.redirect(new URL(path, req.url))
}

export async function middleware(req: NextRequest): Promise<NextResponse> {
  const { pathname } = req.nextUrl

  const isPublicRoute = PUBLIC_ROUTES.some(
    (route) => pathname === route || pathname.startsWith(`${route}/`),
  )

  const accessToken = req.cookies.get('accessToken')?.value
  const refreshToken = req.cookies.get('refreshToken')?.value

  if (accessToken) {
    return isPublicRoute ? redirectTo(req, '/dashboard') : NextResponse.next()
  }

  if (!refreshToken) {
    return isPublicRoute ? NextResponse.next() : redirectTo(req, '/login')
  }

  try {
    const refreshResponse = await fetch(`${API_URL}/auth/refresh`, {
      method: 'POST',
      headers: {
        cookie: req.headers.get('cookie') ?? '',
      },
    })

    if (!refreshResponse.ok) {
      const response = isPublicRoute ? NextResponse.next() : redirectTo(req, '/login')

      response.cookies.delete('accessToken')
      response.cookies.delete('refreshToken')

      return response
    }

    const response = isPublicRoute ? redirectTo(req, '/dashboard') : NextResponse.next()

    const setCookie = refreshResponse.headers.get('set-cookie')

    if (setCookie) {
      response.headers.append('set-cookie', setCookie)
    }

    return response
  } catch {
    return redirectTo(req, '/error')
  }
}

export const config = {
  matcher: [
    '/login',
    '/register',
    '/rooms/:path*',
    '/my-bookings/:path*',
    '/schedule/:path*',
    '/dashboard/:path*',
  ],
}
