// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int    @id @default(autoincrement())
  name         String
  email        String @unique
  passwordHash String

  bookings      Booking[]
  bookingSeries BookingSeries[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  emailVerifiedAt  DateTime?
  verificationCode EmailVerificationCode?

  notifications Notification[]
}

model EmailVerificationCode {
  id        Int      @id @default(autoincrement())
  codeHash  String
  userId    Int      @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Room {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  floor    Int
  capacity Int
  bookings Booking[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Booking {
  id    Int    @id @default(autoincrement())
  title String

  startTime DateTime @db.Timestamptz(3)
  endTime   DateTime @db.Timestamptz(3)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  roomId Int
  room   Room @relation(fields: [roomId], references: [id], onDelete: Restrict)

  seriesId Int?
  series   BookingSeries? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  currentBookingNotifications Notification[] @relation("CurrentBooking")
  nextBookingNotifications    Notification[] @relation("NextBooking")

  @@index([roomId, startTime, endTime])
  @@index([userId, startTime])
  @@index([seriesId])
}

model BookingSeries {
  id               Int @id @default(autoincrement())
  userId           Int
  totalOccurrences Int

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Notification {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentBookingId Int     @unique
  currentBooking   Booking @relation("CurrentBooking", fields: [currentBookingId], references: [id], onDelete: Cascade)

  nextBookingId Int
  nextBooking   Booking @relation("NextBooking", fields: [nextBookingId], references: [id], onDelete: Cascade)

  message String
  readAt  DateTime?

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  deletedAt DateTime? @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([nextBookingId])
}
