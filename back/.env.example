# =========================================================================
# APPLICATION CONFIGURATION TEMPLATE
# =========================================================================
# INSTRUCTIONS:
# 1. Copy BLOCK #1 values into .env for local development and Docker Compose
#    interpolation.
# 2. Copy BLOCK #2 values into .env.prod for variables used inside Docker
#    containers.
#
# IMPORTANT FOR LOCAL API TESTING:
# When testing through http://localhost with Postman or a browser, keep
# MODE=dev. This disables production-only secure cookie settings.
# =========================================================================


# -------------------------------------------------------------------------
# BLOCK #1: LOCAL DEVELOPMENT AND DOCKER COMPOSE BASE
# -------------------------------------------------------------------------

# Application mode: dev or prod
MODE=dev

# Cookie domain used in production
DOMAIN=example.com

# Backend service port exposed on the host
SERVICE_PORT=5000


# -------------------------------------------------------------------------
# DATABASE
# -------------------------------------------------------------------------

# PostgreSQL port exposed on the host
POSTGRES_PORT=5001

# Local PostgreSQL connection string
DATABASE_URL=postgres://myuser:mypassword@localhost:5001/mydb


# -------------------------------------------------------------------------
# REDIS
# -------------------------------------------------------------------------

# Local Redis connection
REDIS_HOST=127.0.0.1
REDIS_PORT=5002


# -------------------------------------------------------------------------
# AUTHENTICATION AND COOKIES
# -------------------------------------------------------------------------

# Replace these values with long random secrets
COOKIES_SECRET=my_cookies_secret
REFRESH_SECRET=my_refresh_secret
ACCESS_SECRET=my_access_secret

# Token lifespan in milliseconds
REFRESH_AGE=2592000000
ACCESS_AGE=900000


# -------------------------------------------------------------------------
# OFFICE SCHEDULE
# -------------------------------------------------------------------------

# Office working hours are validated in this time zone
OFFICE_TIME_ZONE=Europe/Kyiv

# Office opening and closing hours
OFFICE_OPEN_HOUR=9
OFFICE_CLOSE_HOUR=19


# -------------------------------------------------------------------------
# EMAIL VERIFICATION
# -------------------------------------------------------------------------

# Verification link expiration time in hours
EMAIL_VERIFICATION_EXPIRES_HOURS=24


# -------------------------------------------------------------------------
# BOOKING NOTIFICATIONS
# -------------------------------------------------------------------------

# Minutes before booking end to send an in-app notification
NOTIFY_BEFORE_MINUTES=10


# -------------------------------------------------------------------------
# BLOCK #2: DOCKER CONTAINER OVERRIDES
# -------------------------------------------------------------------------

# Keep dev for local Docker testing over HTTP.
# Use prod only with HTTPS and a real domain.
MODE=dev

# Cookie domain used in production
DOMAIN=example.com

# Frontend address available from inside Docker containers
FRONTEND_URL=https://roomly_frontend:3030


# -------------------------------------------------------------------------
# DOCKER DATABASE
# -------------------------------------------------------------------------

POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydb
POSTGRES_PORT=5432

DATABASE_URL=postgres://myuser:mypassword@postgres:5432/mydb


# -------------------------------------------------------------------------
# DOCKER REDIS
# -------------------------------------------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379


# -------------------------------------------------------------------------
# DOCKER AUTHENTICATION AND COOKIES
# -------------------------------------------------------------------------

COOKIES_SECRET=my_cookies_secret
REFRESH_SECRET=my_refresh_secret
ACCESS_SECRET=my_access_secret

REFRESH_AGE=2592000000
ACCESS_AGE=900000


# -------------------------------------------------------------------------
# DOCKER OFFICE SCHEDULE
# -------------------------------------------------------------------------

OFFICE_TIME_ZONE=Europe/Kyiv
OFFICE_OPEN_HOUR=9
OFFICE_CLOSE_HOUR=19


# -------------------------------------------------------------------------
# DOCKER EMAIL VERIFICATION
# -------------------------------------------------------------------------

EMAIL_VERIFICATION_EXPIRES_HOURS=24


# -------------------------------------------------------------------------
# DOCKER BOOKING NOTIFICATIONS
# -------------------------------------------------------------------------

NOTIFY_BEFORE_MINUTES=10