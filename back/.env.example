# ==========================================================================
# ROOMLY ENVIRONMENT CONFIGURATION
# ==========================================================================
#
# Setup:
#
# 1. Copy this file to `.env`.
# 2. Create `.env.prod` for Docker-only overrides.
# 3. Replace all example secrets before deployment.
#
# Docker Compose loads both files in this order:
#
#   .env
#   .env.prod
#
# Values from `.env.prod` override values from `.env`.
#
# Keep MODE=dev while running locally over HTTP.
# Use MODE=prod only when the application is served over HTTPS.
#
# ==========================================================================


# ==========================================================================
# APPLICATION
# ==========================================================================

# Supported values: dev, prod
MODE=dev

# Production cookie domain
DOMAIN=roomly.ua

# Backend HTTP port
SERVICE_PORT=5000

# Public frontend URL used for links such as password reset
FRONTEND_URL=http://localhost:3030


# ==========================================================================
# DATABASE - LOCAL DEVELOPMENT
# ==========================================================================

# PostgreSQL port exposed on the host
POSTGRES_PORT=5001

# Connection string used when the backend runs directly on the host
DATABASE_URL=postgres://bookingUser:bookingPassword@localhost:5001/bookingDB


# ==========================================================================
# AUTHENTICATION AND COOKIES
# ==========================================================================

# Replace all secrets with long, random values
COOKIES_SECRET=replace_with_a_long_random_cookie_secret
REFRESH_SECRET=replace_with_a_long_random_refresh_secret
ACCESS_SECRET=replace_with_a_long_random_access_secret

# Cookie lifetime in milliseconds: 30 days
REFRESH_AGE=2592000000

# Cookie lifetime in milliseconds: 15 minutes
ACCESS_AGE=900000


# ==========================================================================
# OFFICE SCHEDULE
# ==========================================================================

# IANA time zone used to validate booking times
OFFICE_TIME_ZONE=Europe/Kyiv

# Office opening hour: 0–23
OFFICE_OPEN_HOUR=9

# Office closing hour: 1–24
OFFICE_CLOSE_HOUR=19


# ==========================================================================
# EMAIL VERIFICATION
# ==========================================================================

# Verification-code lifetime in hours
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# Minimum delay before requesting another code, in seconds
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60


# ==========================================================================
# PASSWORD RESET
# ==========================================================================

# Password-reset token lifetime in minutes
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Minimum delay before requesting another reset token, in seconds
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60


# ==========================================================================
# BOOKING NOTIFICATIONS
# ==========================================================================

# Send a notification this many minutes before a booking ends
NOTIFY_BEFORE_MINUTES=10


# ==========================================================================
# `.env.prod` EXAMPLE - DOCKER OVERRIDES
# ==========================================================================
#
# Create a separate `.env.prod` file with the following values:
#
# MODE=dev
# FRONTEND_URL=http://localhost:3030
#
# POSTGRES_USER=bookingUser
# POSTGRES_PASSWORD=bookingPassword
# POSTGRES_DB=bookingDB
# POSTGRES_PORT=5432
#
# DATABASE_URL=postgres://bookingUser:bookingPassword@postgres:5432/bookingDB
#
# For a real HTTPS deployment, change:
#
# MODE=prod
# FRONTEND_URL=https://roomly.ua
#
# ==========================================================================